NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/universex
JWT_SECRET=replace-with-a-strong-secret

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173,https://universex-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Auth cookie settings. For deployed cross-site cookies, use COOKIE_SECURE=true and COOKIE_SAME_SITE=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_MS=86400000

# Request/file limits
JSON_BODY_LIMIT=1mb
MAX_FILE_SIZE_BYTES=5242880
FILE_UPLOAD_TEMP_DIR=/tmp/

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=universex

# Mail
MAIL_HOST=
MAIL_USER=
MAIL_PASS=